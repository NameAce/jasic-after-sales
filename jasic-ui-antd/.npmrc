# 默认从 npmmirror（淘宝镜像） 拉包，国内访问 npm 官方源通常更快、更稳。
registry=https://registry.npmmirror.com/
# 把依赖尽量 提升到上层 node_modules，行为更接近 npm/yarn 的“扁平”结构。
# 好处：部分老工具/插件只会在根 node_modules 里找包，开了更容易兼容。
# 代价：和 pnpm 默认的严格隔离略有不同，极少数情况可能掩盖“重复依赖”问题。
shamefully-hoist=true
# 在 monorepo 根目录 也允许装依赖等操作，不会因为“根目录不应直接装包”之类检查而报错（团队按需开启）。
ignore-workspace-root-check=true
# workspace 里的本地包 用链接方式 互相引用，改 workspace 包会立刻反映到依赖它的项目里，开发联调更方便。
link-workspace-packages=true
