# 测试环境后端服务 base url
# 测试包部署到 nginx 后走同源 /api，由 nginx 反代到 127.0.0.1:8080，避免浏览器直连 localhost 触发跨域
VITE_SERVICE_BASE_URL=/api
# 本地 vite dev 开启代理时，后端根地址；会自动拼接上面的 /api 前缀
VITE_SERVICE_PROXY_TARGET=http://127.0.0.1:8080
# VITE_SERVICE_PROXY_TARGET=http://172.16.8.211:8080

# 是否使用 HTTP 代理
VITE_HTTP_PROXY=Y

# 是否使用 refresh 接口
VITE_AUTH_REFRESH_TOKEN=N

# 是否使用后端动态路由
VITE_AUTH_ROUTE_MODE=dynamic

# 是否使用后端菜单标题翻译
VITE_BACKEND_MENU_USE_I18N=N

# 后端响应代码合同
VITE_SERVICE_SUCCESS_CODE=00000
VITE_SERVICE_LOGOUT_CODES=
VITE_SERVICE_MODAL_LOGOUT_CODES=A0100
VITE_SERVICE_EXPIRED_TOKEN_CODES=
VITE_SERVICE_FORBIDDEN_CODES=A0200
VITE_SERVICE_SERVER_ERROR_CODES=A0500

# 其他后端服务 base url, 测试环境
VITE_OTHER_SERVICE_BASE_URL= `{
  "demo": "/api"
}`
