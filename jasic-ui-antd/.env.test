# backend service base url, test environment
# jasic-ui 为 /api -> localhost:8080；此处写实际联调网关（可带 /api 后缀），与 createViteProxy 的 rewrite 规则一致
VITE_SERVICE_BASE_URL=http://localhost:9528/api

# 开发时走 Vite 代理（baseURL=/api），与 jasic-ui devServer.proxy['/api'] 同源策略一致；端口不必与 jasic 相同
VITE_HTTP_PROXY=Y

# 与 .env 一致：无 refresh 接口时不要设为 Y
VITE_AUTH_REFRESH_TOKEN=N

# 测试环境优先走后端动态路由；需要紧急回滚时改回 static（默认值见 .env）
VITE_AUTH_ROUTE_MODE=dynamic

# 后端菜单标题优先，若需要按 i18nKey 翻译可改为 Y
VITE_BACKEND_MENU_USE_I18N=N

# backend response code contract (aligned with jasic-ui + jasic-after-sales)
VITE_SERVICE_SUCCESS_CODE=00000
VITE_SERVICE_LOGOUT_CODES=
VITE_SERVICE_MODAL_LOGOUT_CODES=A0100
VITE_SERVICE_EXPIRED_TOKEN_CODES=
VITE_SERVICE_FORBIDDEN_CODES=A0200
VITE_SERVICE_SERVER_ERROR_CODES=A0500

# other backend service base url, test environment
VITE_OTHER_SERVICE_BASE_URL= `{
  "demo": "http://localhost:9528"
}`
