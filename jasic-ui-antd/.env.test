# 测试环境后端服务 base url
VITE_SERVICE_BASE_URL=http://172.16.211.69/api

# 是否使用 HTTP 代理
VITE_HTTP_PROXY=Y

# 是否使用 refresh 接口
VITE_AUTH_REFRESH_TOKEN=N

# 是否使用后端动态路由
VITE_AUTH_ROUTE_MODE=dynamic

# 是否使用后端菜单标题翻译
VITE_BACKEND_MENU_USE_I18N=N

# 后端响应代码合同
VITE_SERVICE_SUCCESS_CODE=00000
VITE_SERVICE_LOGOUT_CODES=
VITE_SERVICE_MODAL_LOGOUT_CODES=A0100
VITE_SERVICE_EXPIRED_TOKEN_CODES=
VITE_SERVICE_FORBIDDEN_CODES=A0200
VITE_SERVICE_SERVER_ERROR_CODES=A0500

# 其他后端服务 base url, 测试环境
VITE_OTHER_SERVICE_BASE_URL= `{
  "demo": "http://172.16.211.69/"
}`
