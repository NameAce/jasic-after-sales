# Editor configuration, see http://editorconfig.org

root = true

[*]# 字符集
charset = utf-8
# 缩进风格
indent_style = space
# 缩进大小
indent_size = 2
# 行尾换行符
end_of_line = lf
# 删除行尾空白字符
trim_trailing_whitespace = true
# 插入最终换行符
insert_final_newline = true
# 删掉文件末尾尾随逗号
remove_trailing_comma = true
# 单引号风格
quote_style = single